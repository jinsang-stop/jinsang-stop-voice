# 진상 멈춰 `음성 서비스` 환경변수 예시
# 이 파일을 .env로 복사해 쓰거나, 셸에서 직접 export 한다.
# 모든 값은 생략 가능하며, 생략하면 아래 적힌 기본값이 쓰인다.

# --- HTTP ---
# ADR-0008: 이 서비스는 Spring만 호출한다. 외부에 노출하지 않으므로 루프백을 벗어나지 않는다.
JINSANGSTOP_VOICE_HOST=127.0.0.1
JINSANGSTOP_VOICE_PORT=8000

# --- STT(faster-whisper) ---
# 모델 크기: tiny / base / small / medium / large-v3 / turbo
# 시연 장비의 VRAM 예산은 STT에 약 1.5GB뿐이다(ADR-0009 자원 배치표).
# 최종 크기는 파일럿에서 GPU 메모리와 전사 속도를 재고 정한다.
JINSANGSTOP_STT_MODEL=small

# auto면 CUDA 장치가 잡힐 때 cuda, 아니면 cpu로 떨어진다.
JINSANGSTOP_STT_DEVICE=auto

# 생략하면 cuda는 float16, cpu는 int8이 쓰인다.
# JINSANGSTOP_STT_COMPUTE_TYPE=float16

JINSANGSTOP_STT_BEAM_SIZE=5

# 모델 가중치를 받을 위치. 기본값은 저장소의 models/ (gitignore 대상).
# JINSANGSTOP_STT_DOWNLOAD_ROOT=./models

# 받아들일 오디오 최대 크기(바이트). 기본 25MB.
JINSANGSTOP_MAX_AUDIO_BYTES=26214400
